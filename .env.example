# Environment Variables Template for Railway
#
# 📖 HOW TO POPULATE THESE VALUES:
# See ACCESSING_API_KEYS.md for step-by-step instructions on copying
# your API keys from Replit Secrets to Railway.
#
# Copy this to Railway's environment variables section

# ===================================================================
# AI API Keys
# ===================================================================
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-api-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# ===================================================================
# Search APIs
# ===================================================================
PERPLEXITY_API_KEY=pplx-your-perplexity-api-key
SERPAPI_API_KEY=your-serpapi-key

# ===================================================================
# Google APIs (for Google Docs export)
# ===================================================================
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\nHere\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# ===================================================================
# Slack Integration
# ===================================================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# ===================================================================
# Inngest (Workflow Engine)
# ===================================================================
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=signkey-your-inngest-signing-key

# ===================================================================
# Database (Automatically set by Railway PostgreSQL)
# ===================================================================
DATABASE_URL=postgresql://user:password@host:port/database

# ===================================================================
# Application Settings
# ===================================================================
NODE_ENV=production
PORT=5000
